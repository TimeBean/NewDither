@model Service.WebSite.Presentation.Mvc.Models.IndexModel;
@{
    ViewData["Title"] = "Dither";
}

<div class="container mx-auto p-4 max-w-5xl">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8 border-b border-base-300 pb-6">
        <div>
            <h1 class="text-4xl font-black tracking-tight mb-1">Dither</h1>
            <p class="text-base-content/70 text-sm">@Model.RandomQuote</p>
        </div>

        <div class="form-control w-full sm:w-auto min-w-[160px]">
            <label class="label py-1">
                <span class="label-text-alt font-medium">Тема интерфейса</span>
            </label>
            <select id="themeSwitcher" class="select select-bordered select-sm w-full font-medium">
                <option value="light">☀️ Light</option>
                <option value="dark">🌙 Dark</option>
                <option value="cupcake">🧁 Cupcake</option>
                <option value="synthwave">🎆 Synthwave</option>
                <option value="cyberpunk">🤖 Cyberpunk</option>
                <option value="retro">📻 Retro</option>
                <option value="aqua">🌊 Aqua</option>
            </select>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <div class="card bg-base-200 shadow-xl border border-base-300/50">
            <div class="card-body gap-4">
                <h2 class="card-title text-xl font-bold border-b border-base-300 pb-2 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                         stroke-current="currentColor" class="w-6 h-6 text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
                    </svg>
                    Конфигурация
                </h2>

                <form id="ditherForm" class="flex flex-col gap-4" enctype="multipart/form-data">
                    <div class="form-control w-full">
                        <label class="label" for="imageInput">
                            <span class="label-text font-semibold">Исходное изображение</span>
                        </label>
                        <input type="file" id="imageInput" name="file" accept="image/*"
                               class="file-input file-input-bordered file-input-primary w-full" required/>
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="quantizeSelect">
                            <span class="label-text font-semibold">Алгоритм квантования (Quantize)</span>
                        </label>
                        <select id="quantizeSelect" name="quantizationAlgorithm"
                                class="select select-bordered w-full font-medium">
                            <option value="Linear2">Linear 2</option>
                            <option value="Linear4">Linear 4</option>
                            <option value="Linear8">Linear 8</option>
                        </select>
                    </div>

                    <div class="form-control w-full">
                        <label class="label" for="ditherSelect">
                            <span class="label-text font-semibold">Алгоритм дизеринга</span>
                        </label>
                        <select id="ditherSelect" name="ditherAlgorithm"
                                class="select select-bordered w-full font-medium">
                            <option value="FloydSteinberg">Floyd-Steinberg</option>
                            <option value="Atkinson">Atkinson</option>
                            <option value="Burkes">Burkes</option>
                            <option value="OrderedBayer2X2">Bayer (Ordered) 2x2</option>
                            <option value="OrderedBayer4X4">Bayer (Ordered) 4x4</option>
                        </select>
                    </div>

                    <div class="card-actions justify-end mt-4">
                        <button type="submit" id="submitBtn" class="btn btn-primary btn-block text-lg">
                            <span id="loadingSpinner" class="loading loading-spinner hidden"></span>
                            <span>Запустить обработку</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card bg-base-200 shadow-xl border border-base-300/50">
            <div class="card-body flex flex-col justify-between">
                <div>
                    <h2 class="card-title text-xl font-bold border-b border-base-300 pb-2 mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                             stroke-current="currentColor" class="w-6 h-6 text-secondary">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375 0 11-.75 0 .375 0 01.75 0z"/>
                        </svg>
                        Результат обработки
                    </h2>

                    <div
                        class="flex items-center justify-center bg-base-100 rounded-box border-2 border-dashed border-base-300 min-h-[340px] max-h-[500px] p-4 overflow-auto relative">
                        <div id="placeholderText" class="text-base-content/40 text-center select-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1"
                                 stroke-current="currentColor" class="w-16 h-16 mx-auto mb-2 opacity-60">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.25 13.5h3.86a2.25 2.25 0 012.008 1.24l.885 1.77a2.25 2.25 0 002.007 1.24h1.98a2.25 2.25 0 002.007-1.24l.885-1.77a2.25 2.25 0 012.007-1.24h3.86m-18 4.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/>
                            </svg>
                            <p class="font-medium">Ожидание файла...</p>
                            <p class="text-xs mt-1">Сконфигурируйте фильтры слева и нажмите кнопку</p>
                        </div>
                        <img id="resultImage" class="hidden max-w-full max-h-[460px] object-contain shadow-md rounded"
                             alt="Отдизеренное изображение"/>
                    </div>
                </div>

                <div id="statsContainer"
                     class="hidden mt-4 flex justify-between items-center bg-base-100 p-4 rounded-box border border-base-300/40">
                    <span class="text-sm font-bold opacity-80">Время выполнения на сервере:</span>
                    <div
                        class="badge badge-success badge-lg gap-2 py-4 px-3 font-mono text-sm font-bold text-success-content">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                             stroke-current="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span id="executionTime">0 ms</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="toastContainer" class="toast toast-bottom toast-end z-50 p-4"></div>

@section Scripts {
    <script>
        const themeSwitcher = document.getElementById('themeSwitcher');

        themeSwitcher.addEventListener('change', (e) => {
            const currentTheme = e.target.value;
            document.documentElement.setAttribute('data-theme', currentTheme);
            localStorage.setItem('dither_platform_theme', currentTheme);
        });

        function initializeTheme() {
            const savedTheme = localStorage.getItem('dither_platform_theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            if (themeSwitcher) {
                themeSwitcher.value = savedTheme;
            }
        }

        function showToast(message, type = 'error') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const alertBox = document.createElement('div');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-error';

            alertBox.className = `alert ${alertClass} shadow-xl border border-black/10 transition-all duration-300 opacity-0 translate-y-4 max-w-sm`;

            const iconSvg = type === 'success'
                ? `<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;

            alertBox.innerHTML = `
                <div class="flex items-center gap-2">
                    ${iconSvg}
                    <span class="text-sm font-medium">${message}</span>
                </div>
            `;

            container.appendChild(alertBox);

            requestAnimationFrame(() => {
                alertBox.classList.remove('opacity-0', 'translate-y-4');
            });

            setTimeout(() => {
                alertBox.classList.add('opacity-0', 'translate-y-4');
                setTimeout(() => alertBox.remove(), 300);
            }, 3500);
        }

        document.getElementById('ditherForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const form = e.target;
            const submitBtn = document.getElementById('submitBtn');
            const spinner = document.getElementById('loadingSpinner');
            const resultImage = document.getElementById('resultImage');
            const placeholderText = document.getElementById('placeholderText');
            const statsContainer = document.getElementById('statsContainer');
            const executionTimeSpan = document.getElementById('executionTime');

            submitBtn.disabled = true;
            spinner.classList.remove('hidden');
            resultImage.classList.add('hidden');
            placeholderText.classList.remove('hidden');
            statsContainer.classList.add('hidden');

            try {
                const formData = new FormData(form);

                const response = await fetch('/dither/process', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.message || `Ошибка сервера: ${response.status} ${response.statusText}`);
                }

                const data = await response.json();

                if (!data.imageBase64) {
                    throw new Error("Сервер обработал запрос, но не вернул данные изображения.");
                }

                resultImage.src = `data:image/png;base64,${data.imageBase64}`;
                resultImage.classList.remove('hidden');
                placeholderText.classList.add('hidden');

                executionTimeSpan.textContent = `${data.executionTime} ms`;
                statsContainer.classList.remove('hidden');

                showToast('Изображение успешно обработано!', 'success');

            } catch (error) {
                console.error('Ошибка Dithering API:', error);
                showToast(error.message || 'Произошла непредвиденная ошибка при обработке.', 'error');

                placeholderText.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                spinner.classList.add('hidden');
            }
        });

        document.addEventListener('DOMContentLoaded', initializeTheme);
    </script>

    <script>
        const img = document.getElementById('resultImage');

        img.addEventListener('click', () => {
            const a = document.createElement('a');
            a.href = img.src;
            a.download = 'image.png';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });
    </script>
}
